# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep the libxposed module entry class (referenced by META-INF/xposed/java_init.list).
-keep class ss.colytitse.setappfull.MainHook { *; }

# Keep BuildConfig fields used by the hook (APPLICATION_ID).
-keep class ss.colytitse.setappfull.BuildConfig { *; }
